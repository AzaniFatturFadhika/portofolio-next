# Base URL for SEO Metadata & Sitemap Generation
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Formspree Form ID for Contact Form Submissions (Optional for local testing simulation)
NEXT_PUBLIC_FORMSPREE_KEY=your_formspree_form_id

# Payload CMS
PAYLOAD_SECRET=your_long_random_payload_secret
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Neon Object Storage (S3-compatible, branch-scoped, path-style only)
S3_BUCKET=your_bucket_name
AWS_ENDPOINT_URL_S3=https://your-branch-endpoint.storage.region.aws.neon.tech
AWS_ACCESS_KEY_ID=your_neon_token_id
AWS_SECRET_ACCESS_KEY=your_neon_token_secret
AWS_REGION=us-east-1
