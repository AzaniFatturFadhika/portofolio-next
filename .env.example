# Base URL for SEO Metadata & Sitemap Generation
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Formspree Form ID for Contact Form Submissions (Optional for local testing simulation)
NEXT_PUBLIC_FORMSPREE_KEY=your_formspree_form_id

# Outstatic CMS — GitHub OAuth app credentials for the /outstatic dashboard.
# Create an OAuth app at https://github.com/settings/developers and set the
# callback URL to <your-site>/api/outstatic/callback
OST_GITHUB_ID=your_github_oauth_app_id
OST_GITHUB_SECRET=your_github_oauth_app_secret

# Repository slug (e.g. for owner/repo, OST_REPO_SLUG=repo). On Vercel this
# defaults to VERCEL_GIT_REPO_SLUG when empty.
OST_REPO_SLUG=portofolio-next

# Repository owner. Defaults to the signed-in GitHub username when empty.
OST_REPO_OWNER=AzaniFatturFadhika

# Main branch of the repository. Defaults to 'main' when empty.
OST_REPO_BRANCH=main
